# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Port
PORT=5000

# MongoDB Connection URI
# Format: mongodb://[username:password@]host[:port][/database]
# For local development: mongodb://localhost:27017/att_sys
MONGODB_URI=mongodb://localhost:27017/att_sys

# JWT Secret for token signing (use a strong random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this

# Frontend URL for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://localhost:3000
